# ==============================================================================
# Nexus Multi-Agent Swarm Environment Configuration
# ==============================================================================

# LangSmith Observability & Tracing (smith.langchain.com)
LANGCHAIN_TRACING_V2=true
LANGCHAIN_ENDPOINT="https://api.smith.langchain.com"
LANGCHAIN_API_KEY=lsv2_pt_your_langsmith_api_key_here
LANGCHAIN_PROJECT="nexus-multi-agent-system"

# LLM Providers (Optional for demo mode - deterministic fallback included)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL_NAME=gpt-4o-mini
